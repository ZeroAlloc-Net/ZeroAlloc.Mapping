<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroAlloc.Mapping.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);HLQ001;HLQ005;MA0002;MA0004;MA0006;MA0047;MA0048;MA0074;NU1608;NU1701;EPC12</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.TestHelpers" Version="1.2.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Mapping.Generator\ZeroAlloc.Mapping.Generator.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Mapping\ZeroAlloc.Mapping.csproj" />
  </ItemGroup>

  <!-- Snapshots are data, not code. Verify's targets excluded them from compilation; without
       that every .verified.cs is compiled and collides (CS0101). -->
  <ItemGroup>
    <Compile Remove="**/*.verified.*" />
    <Compile Remove="**/*.received.*" />
  </ItemGroup>

</Project>
